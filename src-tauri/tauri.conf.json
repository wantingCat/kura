{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kura",
  "version": "1.0.0",
  "identifier": "io.github.kura.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Kura",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "maximized": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https: data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; media-src 'self' asset: http://asset.localhost http://127.0.0.1:* blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/images/**", "$LOCALAPPDATA/**/images/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Kura contributors",
    "copyright": "Copyright © 2026 Kura contributors. Licensed under GPL-3.0-or-later.",
    "category": "Video",
    "shortDescription": "A Japanese immersion suite for anime",
    "longDescription": "Kura combines a local & streaming anime library, native libmpv playback with Anime4K shaders, automatic Jimaku Japanese subtitle retiming, pause-to-hover Yomitan dictionary lookups, vocabulary revision tracking, and two-way AniList sync.",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/mpv/*",
      "resources/shaders/*"
    ],
    "linux": {
      "deb": {
        "depends": ["mpv"]
      },
      "rpm": {
        "depends": ["mpv"]
      }
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "installMode": "currentUser"
      },
      "wix": {
        "upgradeCode": "92E2D647-73B8-43C4-9721-6A26A2DBA8BC",
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyNjk5MDlEOUE3MjY0NkMKUldSc1pIS2FuWkJwd3Fxc1REbXdXU1RlQWR4S2k1MVYvOUQyZDEvMXFCTnpqTS9lVTZFR1dhVTAK",
      "endpoints": ["https://github.com/wantingCat/kura/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
